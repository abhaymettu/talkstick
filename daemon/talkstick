def merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


def config_path() -> Path:
    return Path(os.environ.get("TALKSTICK_CONFIG") or "~/.config/talkstick/config.json").expanduser()


def load_config(path: Path | None = None) -> dict:
    path = path or config_path()
    cfg = merge(DEFAULTS, json.loads(path.read_text())) if path.exists() else dict(DEFAULTS)
    if os.environ.get("TALKSTICK_DRY") == "1":
        cfg["dry"] = True
    return cfg


def expand(p: str) -> Path:
    return Path(os.path.expandvars(p)).expanduser()


def which(binary: str) -> str:
    if "/" in binary:
        return str(expand(binary))
    found = shutil.which(binary, path=os.environ.get("PATH", "") + ":/opt/homebrew/bin:/usr/local/bin:/usr/bin")
    if not found:
        raise StepError(f"{binary} not found")
    return found


def now() -> float:
    return time.time()


def run(cmd: list[str], timeout: float = 30, stdin: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)


class StepError(Exception):
    """A failure the stick shows as `ERR <reason>`."""


class Offline(Exception):
    """The delivery target is down; the stick shows OFFLINE."""


class Turnstile:
    """Lets ticket holders through one at a time, in the order the tickets were taken. A ticket released before
    its turn (an early failure) is skipped when its turn comes."""

    def __init__(self):
        self.cond = threading.Condition()
        self.issued = 0
        self.serving = 0
        self.done: set[int] = set()

    def take(self) -> int:
        with self.cond:
            self.issued += 1
            return self.issued - 1

    def wait(self, ticket: int) -> None:
        with self.cond:
            self.cond.wait_for(lambda: self.serving >= ticket)

    def release(self, ticket: int) -> None:
        with self.cond:
            if ticket < self.serving or ticket in self.done:
                return
            self.done.add(ticket)
            while self.serving in self.done:
                self.done.discard(self.serving)
                self.serving += 1
            self.cond.notify_all()


class Item:
    """One utterance from RECV to its answer. waiting: SENT and no answer yet. report: the delivery's last status
    line about the target, "busy" or "running"."""

    def __init__(self, uid: str, device: str):
        self.id, self.device = uid, device
        self.t_recv = now()
        self.said = ""
        self.waiting = False
        self.report: str | None = None


class Watcher:
    def __init__(self, device: str, fw: str | None, send):
        self.device, self.fw, self.send = device, fw, send


def flat(text: str) -> str:
    return re.sub(r"[\t\r\n]", " ", text)


def answer_line(a: dict) -> str:
    return f"ANSWER {a['id']} {a['outcome']} {a['said']}\t{a['text']}"


def write_atomic(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_bytes(data)
    os.replace(tmp, path)


class Daemon:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.state = expand(cfg["state_dir"])
        self.events = self.state / "events.jsonl"
        self.events_lock = threading.Lock()
        self.reply_lock = threading.Lock()
        self.reply_threads: list = []
        self.turn = Turnstile()
        self.lock = threading.RLock()
        self.items: dict[str, dict[str, Item]] = {}
        self.watchers: dict[str, list[Watcher]] = {}
        self.queue_sent: dict[str, str] = {}
        self.ack_cond = threading.Condition(self.lock)
        self.acked: list[tuple[str, str]] = []
        self.answers: dict[str, list[dict]] = {}
        self.delivered: dict[str, list[list[str]]] = {}
        self.load_answers()
        self.ota = load_manifest(self.state)

    @property
    def dry(self) -> bool:
        return bool(self.cfg["dry"])

    def log_event(self, row: dict) -> None:
        self.state.mkdir(parents=True, exist_ok=True)
        row = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **row}
        with self.events_lock, open(self.events, "a") as f:
            f.write(json.dumps(row) + "\n")

    # Transcription

    def transcribe(self, wav: Path, status, rec: dict) -> str:
        eng = self.cfg["engine"]
        kind = eng["type"]
        rec["engine"] = kind
        if kind == "whisper":
            return whisper_transcribe(eng["whisper"], wav)
        if kind == "command":
            return command_transcribe(eng["command"], wav)
        if kind == "wispr-macos":
            wcfg = eng["wispr-macos"]
            try:
                return WisprMac(wcfg, self.log_event).transcribe(wav, status, rec)
            except (StepError, UserActive) as e:
                if wcfg.get("fallback") != "whisper":
                    raise StepError("mac busy" if isinstance(e, UserActive) else str(e))
                rec["engine"], rec["wispr_skipped"] = "whisper", str(e) or "user active"
                return whisper_transcribe(eng["whisper"], wav)
        raise StepError(f"engine {kind}?")

    # Delivery

    def deliver(self, text: str, rec: dict, sent, report) -> str:
        """sent() runs once the text is in the target; report("busy" | "running") on the target's state."""
        d = self.cfg["delivery"]
        kind = d["type"]
        rec["delivery"] = kind
        if kind == "print":
            print(f"[talkstick] {rec.get('device')}: {text}", flush=True)
            sent()
            return ""
        if kind == "command":
            return deliver_command(d["command"], text, rec, self.dry, sent, report)
        if kind == "webhook":
            reply = deliver_webhook(d["webhook"], text, rec, self.dry)
            sent()
            return reply
        raise StepError(f"delivery {kind}?")

    # Queue and answers, per device. Everything here runs under self.lock, so watchers see lines in order.

    @property
    def answers_file(self) -> Path:
        return self.state / "answers.json"

    def load_answers(self) -> None:
        """answers.json: {"answers": {device: [unacked answer]}, "delivered": {device: [[id, said]]}}."""
        try:
            data = json.loads(self.answers_file.read_text())
        except (OSError, ValueError):
            data = {}
        if not isinstance(data, dict):
            data = {}
        self.answers = data.get("answers") or {}
        self.delivered = data.get("delivered") or {}

    def save_answers(self) -> None:
        write_atomic(self.answers_file, json.dumps({"answers": self.answers, "delivered": self.delivered}).encode())

    def duplicate(self, device: str, uid: str) -> tuple[str, str] | None:
        """("delivered", said) or ("in_progress", "") for an id this device sent before, else None."""
        for did, said in self.delivered.get(device, []):
            if did == uid:
                return "delivered", said
        return ("in_progress", "") if uid in self.items.get(device, {}) else None

    def queue_line(self, device: str) -> str:
        waiting = [i for i in self.items.get(device, {}).values() if i.waiting]
        reports = [i.report for i in waiting]
        busy = int("busy" in reports and "running" not in reports)
        return f"QUEUE {len(waiting)} {busy} {max(len(waiting) - 1, 0) + busy} {reports.count('paused')}"

    def push(self, device: str, line: str) -> None:
        with self.lock:
            for w in list(self.watchers.get(device, [])):
                if w.send(line) is False:
                    self.unwatch(w)

    @property
    def queue_file(self) -> Path:
        return self.state / "queue.json"

    def items_changed(self, device: str) -> None:
        """Write the in-flight items for `talkstick status`, and push QUEUE if it changed."""
        with self.lock:
            write_atomic(self.queue_file, json.dumps({
                d: {"queue": [int(n) for n in self.queue_line(d).split()[1:]],
                    "items": [{"id": i.id, "state": i.report or ("waiting" if i.waiting else "sending"),
                               "since": i.t_recv, "said": i.said} for i in items.values()]}
                for d, items in self.items.items() if items}).encode())
            line = self.queue_line(device)
            if self.queue_sent.get(device) != line:
                self.queue_sent[device] = line
                self.push(device, line)

    def open_item(self, rec: dict) -> Item:
        item = Item(rec["utterance_id"][:8], rec.get("device") or "")
        with self.lock:
            self.items.setdefault(item.device, {})[item.id] = item
            self.items_changed(item.device)
        return item

    def recover_orphans(self) -> None:
        """Answer the items a previous run left in flight: their delivery commands died with it, so no reply will
        come. Delivered ones say where the reply is; the rest ask to be said again."""
        try:
            left = json.loads(self.queue_file.read_text())
        except (OSError, ValueError):
            left = {}
        with self.lock:
            for device, q in (left.items() if isinstance(left, dict) else []):
                for i in q.get("items") or []:
                    item = Item(i["id"], device)
                    item.said = i.get("said") or ""
                    self.close_item(item, "error", ORPHAN_UNSENT if i.get("state") == "sending" else ORPHAN_SENT)
                    self.log_event({"event": "orphaned", "id8": item.id, "device": device, "state": i.get("state")})
            write_atomic(self.queue_file, b"{}")

    def mark_sent(self, item: Item) -> None:
        with self.lock:
            item.waiting = True
            self.delivered[item.device] = (self.delivered.get(item.device, []) + [[item.id, item.said]])[-KEEP_DELIVERED:]
            self.save_answers()
            self.items_changed(item.device)

    def update_item(self, item: Item, **changes) -> None:
        with self.lock:
            for k, v in changes.items():
                setattr(item, k, v)
            self.items_changed(item.device)

    def close_item(self, item: Item, outcome: str, text: str) -> None:
        a = {"id": item.id, "outcome": outcome, "said": item.said, "text": text.replace("\t", " ")}
        with self.lock:
            self.items.get(item.device, {}).pop(item.id, None)
            self.answers[item.device] = (self.answers.get(item.device, []) + [a])[-KEEP_ANSWERS:]
            self.save_answers()
            self.push(item.device, answer_line(a))
            self.items_changed(item.device)

    def ack(self, device: str, aid: str) -> None:
        with self.lock:
            self.acked = self.acked[-255:] + [(device, aid)]
            self.ack_cond.notify_all()
            kept = [a for a in self.answers.get(device, []) if a["id"] != aid]
            if len(kept) != len(self.answers.get(device, [])):
                self.answers[device] = kept
                self.save_answers()

    # Watch connections and over-the-air updates

    def watch(self, rfile, status, header: dict) -> None:
        """Register a watcher, send it the queue, unacked answers and any update offer, then read K and L frames
        until the stick goes away. A read timeout is only a quiet stick."""
        w = Watcher(header["device"], header.get("fw"), status)
        with self.lock:
            self.watchers.setdefault(w.device, []).append(w)
            self.queue_sent[w.device] = self.queue_line(w.device)
            status(self.queue_sent[w.device])
            for a in self.answers.get(w.device, []):
                status(answer_line(a))
            self.offer(w)
            self.note_applied(w)
        try:
            while True:
                try:
                    f = read_frame(rfile)
                except socket.timeout:
                    continue
                except OSError:
                    break
                if f is None:
                    break
                kind, payload = f
                if kind == b"K":
                    self.ack(w.device, payload.decode("ascii", "replace").strip())
                elif kind == b"L":
                    self.log_stick(header, payload)
        finally:
            self.unwatch(w)

    def unwatch(self, w: Watcher) -> None:
        with self.lock:
            ws = self.watchers.get(w.device, [])
            if w in ws:
                ws.remove(w)

    def heartbeat(self) -> None:
        line = time_line()
        with self.lock:
            devices = list(self.watchers)
        for device in devices:
            self.push(device, line)

    def offer(self, w: Watcher) -> None:
        m = self.ota
        if not m or w.fw == m["version"] or read_ota_key(self.cfg) is None:
            return
        if w.send(f"OTA {m['size']} {m['sha256']} {m['mac']} {m['version']}") is not False:
            self.log_event({"event": "ota_offer", "device": w.device, "fw": w.fw, "version": m["version"]})

    def note_applied(self, w: Watcher) -> None:
        m = self.ota
        marker = self.state / "ota" / "applied"
        if not m or w.fw != m["version"]:
            return
        try:
            if marker.read_text() == m["staged"]:
                return
        except OSError:
            pass
        write_atomic(marker, m["staged"].encode())
        self.log_event({"event": "ota_applied", "device": w.device, "version": m["version"], "staged": m["staged"]})

    def check_ota(self) -> None:
        """Offer a newly staged or changed image to every watcher on another version."""
        m = load_manifest(self.state)
        with self.lock:
            if m == self.ota:
                return
            self.ota = m
            for ws in list(self.watchers.values()):
                for w in list(ws):
                    self.offer(w)

    def tick_forever(self, stop: threading.Event) -> None:
        n = 0
        while not stop.wait(WATCH_TICK):
            n += 1
            self.check_ota()
            if n % HEARTBEAT_EVERY == 0:
                self.heartbeat()

    def send_image(self, version: str, status, rec: dict) -> None:
        m = load_manifest(self.state)
        data = b""
        if m and m["version"] == version:
            try:
                data = (self.state / "ota" / "image.bin").read_bytes()
            except OSError:
                pass
        sha = hashlib.sha256(data).hexdigest()
        if not data or len(data) != m["size"] or sha != m["sha256"]:
            status("ERR no image")
            self.log_event({"event": "ota_fetch", "version": version, "error": "no image", **rec})
            return
        t0 = now()
        ok = status(f"IMAGE {len(data)} {sha}\n".encode() + data) is not False
        self.log_event({"event": "ota_fetch", "version": version, "bytes": len(data),
                        "seconds": round(now() - t0, 3), "ok": ok, **rec})

    def log_stick(self, header: dict, payload: bytes) -> None:
        self.log_event({"event": "stick_log", "device": header.get("device"), "fw": header.get("fw"),
                        "text": payload[:STICK_LOG_BYTES].decode("utf-8", "replace")})

    def on_reply(self, reply: str, rec: dict) -> None:
        """Hand the reply on (a phone text, a notification). Runs after the stick already has the reply, so a
        failure here is logged in the event row and never turns a delivered reply into an error."""
        argv = self.cfg.get("on_reply")
        if not argv or not reply.strip():
            return
        msg = trim_reply(reply, self.cfg["reply_max_chars"], self.cfg["reply_more_suffix"])
        if self.dry:
            print(f"[dry] on_reply {argv[0]} <- {len(msg)} chars", flush=True)
            rec["on_reply_rc"] = "dry"
            return
        try:
            p = subprocess.run(argv, input=msg, capture_output=True, text=True,
                               timeout=float(self.cfg["on_reply_timeout"]))
            rec["on_reply_rc"], err = p.returncode, p.stderr.strip()[-200:]
        except (OSError, subprocess.TimeoutExpired) as e:
            rec["on_reply_rc"], err = "failed", f"{type(e).__name__}: {e}"[:200]
        rec["t_on_reply"] = now()
        if rec["on_reply_rc"] != 0:
            rec["on_reply_error"] = err

    def hand_on(self, reply: str, rec: dict) -> None:
        """Run on_reply on its own thread, so a slow phone text never holds up the next utterance. Replies are
        handed on in order (reply_lock); the outcome is logged as its own "on_reply" event. With on_reply_when
        "unacked", a reply the stick acks within on_reply_grace seconds is not handed on."""
        uid, t_release = rec.get("utterance_id"), rec.get("t_release")
        key = (rec.get("device") or "", (uid or "")[:8])
        deadline = now() + float(self.cfg["on_reply_grace"])
        wait = self.cfg["on_reply_when"] == "unacked" and self.cfg.get("on_reply") and reply.strip()

        def job() -> None:
            with self.reply_lock:
                r: dict = {}
                if wait:
                    with self.ack_cond:
                        acked = self.ack_cond.wait_for(lambda: key in self.acked, max(deadline - now(), 0))
                    if acked:
                        self.log_event({"event": "on_reply", "utterance_id": uid, "rc": "skipped",
                                        "decision": "skipped: acked by stick"})
                        return
                    r["decision"] = f"sent: not acked in {float(self.cfg['on_reply_grace']):g} s"
                self.on_reply(reply, r)
                if "on_reply_rc" in r:
                    row = {"event": "on_reply", "utterance_id": uid, "rc": r["on_reply_rc"]}
                    if r.get("decision"):
                        row["decision"] = r["decision"]
                    if t_release and r.get("t_on_reply"):
                        row["d_on_reply"] = round(r["t_on_reply"] - t_release, 3)
                    if r.get("on_reply_error"):
                        row["error"] = r["on_reply_error"]
                    self.log_event(row)

        t = threading.Thread(target=job, daemon=True)
        self.reply_threads = [x for x in self.reply_threads if x.is_alive()] + [t]
        t.start()

    def wait_replies(self, timeout: float = 10) -> None:
        for t in list(self.reply_threads):
            t.join(timeout)

    # Pipeline

    def save_wav(self, pcm: bytes, uid: str) -> Path:
        d = self.state / "utterances"
        d.mkdir(parents=True, exist_ok=True)
        path = d / f"{time.strftime('%Y%m%d-%H%M%S')}-{uid[:8]}.wav"
        with wave.open(str(path), "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm)
        keep = int(self.cfg["keep_utterances"])
        for old in sorted(d.glob("*.wav"))[:-keep]:
            old.unlink()
        return path

    @property
    def last_reply_file(self) -> Path:
        return self.state / "last_reply.txt"

    def last_reply(self) -> str:
        try:
            return self.last_reply_file.read_text().strip()
        except OSError:
            return ""

    def send_reply_to_stick(self, reply: str, status) -> None:
        line = stick_line(reply, int(self.cfg["stick_reply_chars"]))
        if line:
            self.state.mkdir(parents=True, exist_ok=True)
            self.last_reply_file.write_text(line + "\n")
            status(f"REPLY {line}")

    def process(self, get_text, status, rec: dict, ticket: int, item: Item | None = None) -> None:
        """Wait for this ticket's turn, get the text (transcribe, or the status prompt) and deliver it, then let
        the next ticket through and wait for the reply holding nothing. `rec` collects the timings written to
        events.jsonl; `item` (absent for bench) carries the queue state and becomes an ANSWER."""
        text, answer = "", ""

        def sent() -> None:
            if "t_sent" in rec:
                return
            rec["t_sent"] = now()
            status(f"SENT {text[:40]}")
            self.turn.release(ticket)
            row = {"event": "delivered", "id8": rec["utterance_id"][:8]}
            if rec.get("t_release"):
                row["d_sent"] = round(rec["t_sent"] - rec["t_release"], 3)
            self.log_event(row)
            if item:
                self.mark_sent(item)

        def report(kind: str) -> None:
            if item:
                self.update_item(item, report=kind)

        try:
            self.turn.wait(ticket)
            text = get_text()
            rec["t_transcript"] = now()
            rec["transcript_chars"] = len(text)
            if item:
                item.said = flat(text[:40])
            if not text:
                raise StepError("empty transcript")
            reply = self.deliver(text, rec, sent, report)
            rec["t_reply"] = now()
            rec["reply_chars"] = len(reply)
            answer = stick_line(reply, int(self.cfg["stick_reply_chars"]))
            self.send_reply_to_stick(reply, status)
            rec["t_done"] = now()
            rec["outcome"] = "replied"
            status("REPLIED")
            self.hand_on(reply, rec)
        except Offline:
            rec["outcome"], answer = "offline", "target offline"
            status("OFFLINE")
            if self.cfg.get("offline_message"):
                self.hand_on(self.cfg["offline_message"], rec)
        except StepError as e:
            rec["outcome"], rec["error"] = "error", str(e)
            answer = f"ERR {e}"[4:60]
            status(f"ERR {e}"[:60])
        except Exception as e:
            rec["outcome"], rec["error"] = "error", f"{type(e).__name__}: {e}"[:200]
            answer = "internal"
            status("ERR internal")
        finally:
            self.turn.release(ticket)
            if item:
                self.close_item(item, rec.get("outcome") or "error", answer)
            r = rec.get("t_release")
            for k in ("t_transcript", "t_sent", "t_reply", "t_done"):
                if r and rec.get(k):
                    rec["d_" + k[2:]] = round(rec[k] - r, 3)
            rec["dry"] = self.dry
            self.log_event({"event": "utterance", **rec})

    # Server

    def make_server(self, address: tuple) -> Server:
        daemon = self

        class Handler(socketserver.BaseRequestHandler):
            def handle(self) -> None:
                self.request.settimeout(150)
                conn = Conn(self.request)
                daemon.handle_stick(conn, conn.send, self.client_address[0])

        return Server(address, Handler)

    def serve(self) -> None:
        self.state.mkdir(parents=True, exist_ok=True)
        state_file = self.state / "state.json"
        kill_stale_advertiser(state_file)
        self.recover_orphans()
        srv = self.make_server(("0.0.0.0", int(self.cfg["port"])))
        ticker_stop = threading.Event()
        threading.Thread(target=self.tick_forever, args=(ticker_stop,), daemon=True).start()
        adv = None
        if self.cfg["advertise"]:
            adv = advertise(self.cfg["service_name"], self.cfg["service_type"], int(self.cfg["port"]))
        state_file.write_text(json.dumps({
            "pid": os.getpid(), "advertiser_pid": adv.pid if adv else None, "port": self.cfg["port"],
            "engine": self.cfg["engine"]["type"], "delivery": self.cfg["delivery"]["type"], "dry": self.dry,
            "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")}))

        def stop(*_):
            if adv:
                adv.terminate()
            threading.Thread(target=srv.shutdown, daemon=True).start()

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        self.log_event({"event": "start", "engine": self.cfg["engine"]["type"],
                        "delivery": self.cfg["delivery"]["type"], "dry": self.dry, "pid": os.getpid()})
        try:
            srv.serve_forever()
        finally:
            ticker_stop.set()
            if adv:
                adv.terminate()
            srv.server_close()
            self.log_event({"event": "stop"})

    def handle_stick(self, rfile, status, peer: str) -> None:
        rec: dict = {"peer": peer, "utterance_id": uuid.uuid4().hex}
        try:
            u = read_utterance(rfile, on_header=lambda _: status(time_line()))
        except (socket.timeout, OSError) as e:
            self.log_event({"event": "dropped", "reason": type(e).__name__, **rec})
            return
        rec.update(u.header)
        for text in u.logs:
            self.log_stick(u.header, text)
        if u.outcome == "watch":
            self.watch(rfile, status, u.header)
            return
        if u.outcome == "fetch":
            self.send_image(u.arg, status, rec)
            return
        if u.outcome == "ping":
            last = self.last_reply()
            if last:
                status(f"LAST {last}")
            return
        if u.outcome == "status" and not self.cfg.get("status_prompt"):
            status("ERR no status_prompt")
            self.log_event({"event": "status_unconfigured", **rec})
            return
        if u.outcome == "too_long":
            status("ERR too long")
        if u.outcome not in ("end", "status"):
            self.log_event({"event": u.outcome, "bytes": len(u.pcm), **rec})
            return
        rec["kind"], rec["t_release"] = ("utterance" if u.outcome == "end" else "status"), now()
        sid = u.arg if re.fullmatch(r"[0-9a-f]{8}", u.arg) else ""
        if sid:
            rec["utterance_id"] = sid + rec["utterance_id"][8:]
        with self.lock:
            dup = self.duplicate(rec["device"], sid) if sid else None
            if not dup:
                ticket = self.turn.take()
                item = self.open_item(rec)
        if dup:
            status("RECV")
            status(f"ID {sid}")
            status(f"SENT {dup[1]}" if dup[0] == "delivered" else "ERR busy")
            self.log_event({"event": "duplicate", "id8": sid, "device": rec["device"], "state": dup[0],
                            "kind": rec["kind"]})
            return
        try:
            if u.outcome == "end":
                rec["audio_s"] = round(len(u.pcm) / (RATE * 2), 2)

                def get_text() -> str:
                    wav = self.save_wav(u.pcm, rec["utterance_id"])
                    rec["wav"] = wav.name
                    return self.transcribe(wav, status, rec)
            else:
                prompt = self.cfg["status_prompt"]
                get_text = lambda: prompt
            status("RECV")
            status(f"ID {item.id}")
            self.log_event({"event": "received", "utterance_id": rec["utterance_id"], "id8": item.id,
                            "device": item.device, "kind": rec["kind"], "audio_s": rec.get("audio_s")})
            self.process(get_text, status, rec, ticket, item)
        finally:
            self.turn.release(ticket)


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


class Conn:
    """A stick's socket. Reads keep partial data across a timeout, so a quiet watch connection can be read again;
    send() may be called from any thread and returns False once the stick is gone."""

    def __init__(self, sock: socket.socket):
        self.sock, self.buf, self.lock = sock, bytearray(), threading.Lock()

    def _fill(self) -> bool:
        chunk = self.sock.recv(65536)
        self.buf += chunk
        return bool(chunk)

    def _take(self, n: int) -> bytes:
        out = bytes(self.buf[:n])
        del self.buf[:n]
        return out

    def readline(self, limit: int) -> bytes:
        while b"\n" not in self.buf and len(self.buf) < limit and self._fill():
            pass
        i = self.buf.find(b"\n", 0, limit)
        return self._take(i + 1 if i >= 0 else limit)

    def read(self, n: int) -> bytes:
        while len(self.buf) < n and self._fill():
            pass
        return self._take(n)

    def send(self, line: str | bytes) -> bool:
        data = line if isinstance(line, bytes) else (line + "\n").encode()
        with self.lock:
            try:
                self.sock.sendall(data)
                return True
            except OSError:
                try:
                    self.sock.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                return False


class Utterance:
    def __init__(self, outcome: str, header: dict):
        self.outcome, self.header = outcome, header
        self.pcm = b""
        self.arg = ""
        self.logs: list[bytes] = []


FRAME_OUTCOMES = {b"C": "cancel", b"E": "end", b"S": "status", b"P": "ping", b"W": "watch", b"F": "fetch"}


def read_frame(rfile) -> tuple[bytes, bytes] | None:
    """(type, payload), or None at end of stream. A timeout before a frame starts propagates as socket.timeout;
    one inside a frame is an error."""
    head = rfile.read(3)
    if len(head) < 3:
        return None
    length = struct.unpack("<H", head[1:])[0]
    try:
        payload = rfile.read(length) if length else b""
    except socket.timeout:
        raise ConnectionError("timed out inside a frame")
    return (head[:1], payload) if len(payload) == length else None


def read_utterance(rfile, on_header=None) -> Utterance:
    """Parse one M5R1 connection up to the frame that decides it. outcome: end | status | ping | cancel | watch |
    fetch | bad_header | truncated | too_long. L frames on the way are collected in logs. on_header(header) runs
    as soon as the HELLO line parses, before any frame is read."""
    words = rfile.readline(200).decode("ascii", "replace").split()
    if len(words) < 2 or words[0] != "M5R1":
        return Utterance("bad_header", {})
    header = {"device": words[1], "battery": words[2] if len(words) > 2 else None,
              "fw": words[3] if len(words) > 3 else None, "t_connect": now()}
    if on_header:
        on_header(header)
    u, pcm = Utterance("truncated", header), bytearray()
    while True:
        f = read_frame(rfile)
        if f is None:
            break
        kind, payload = f
        if kind == b"A":
            pcm += payload
            if len(pcm) > MAX_AUDIO_BYTES:
                u.outcome = "too_long"
                break
        elif kind == b"L":
            u.logs.append(payload)
        elif kind in FRAME_OUTCOMES:
            u.outcome = FRAME_OUTCOMES[kind]
            u.arg = payload.decode("ascii", "replace").strip()
            break
    if u.outcome in ("end", "cancel", "truncated", "too_long"):
        u.pcm = bytes(pcm)
    return u


def time_line(t: float | None = None) -> str:
    t = now() if t is None else t
    return f"TIME {int(t)} {time.localtime(t).tm_gmtoff}"


def stick_line(text: str, max_chars: int = STICK_REPLY_CHARS) -> str:
    """One protocol line of at most max_chars characters after encoding; a newline is written as the two
    characters \\n and is never cut in half."""
    out, size = [], 0
    for ch in text.strip().replace("\r\n", "\n").replace("\r", "\n"):
        piece = "\\n" if ch == "\n" else ch
        if size + len(piece) > max_chars:
            break
        out.append(piece)
        size += len(piece)
    return "".join(out).rstrip()


def trim_reply(text: str, max_chars: int | None, suffix: str) -> str:
    text = text.strip()
    if not max_chars or len(text) <= max_chars:
        return text
    return text[:max_chars].rstrip() + suffix


# Engines

def whisper_transcribe(wcfg: dict, wav: Path) -> str:
    model = expand(wcfg["model"])
    if not model.exists():
        raise StepError("whisper model missing")
    p = run([which(wcfg["binary"]), "-m", str(model), "-f", str(wav), "-nt", "-np", *wcfg.get("extra_args", [])],
            timeout=120)
    if p.returncode != 0:
        raise StepError("whisper failed")
    text = " ".join(p.stdout.split())
    return re.sub(r"\[(BLANK_AUDIO|MUSIC|SILENCE)\]|\(.*?\)", "", text).strip()


def command_transcribe(ccfg: dict, wav: Path) -> str:
    argv = [a.replace("{wav}", str(wav)) for a in ccfg["argv"]]
    if not argv:
        raise StepError("engine argv empty")
    p = run(argv, timeout=float(ccfg.get("timeout", 120)))
    if p.returncode != 0:
        raise StepError(f"engine exit {p.returncode}")
    return " ".join(p.stdout.split())


class UserActive(Exception):
    pass


class WisprMac:
    """EXPERIMENTAL, macOS only. Drives the Wispr Flow app: plays the utterance into a loopback device (BlackHole)
    while Wispr's mic is set to it, with talkstick's own sink window frontmost so Wispr's paste lands there, then
    reads the transcript from Wispr's history database (read-only). It only runs while the person has not touched
    keyboard or mouse for idle_seconds, re-checks that throughout, and restores their front app and Wispr mic.
    No synthetic keystrokes and no permission grants. Known issue: Wispr has been seen to record the previous front
    app as the paste target even with the sink in front, so verify the paste target before relying on it."""

    def __init__(self, wcfg: dict, log_event):
        self.c = wcfg
        self.log_event = log_event
        self.support = expand(wcfg["app_support"])
        self.sink_app = expand(wcfg["sink_app"])
        self.sink_id = wcfg["sink_bundle_id"]

    @staticmethod
    def hid_idle() -> float:
        m = re.search(r'"HIDIdleTime" = (\d+)', run(["/usr/sbin/ioreg", "-c", "IOHIDSystem", "-d", "4"]).stdout)
        return int(m.group(1)) / 1e9 if m else 0.0

    def user_active(self) -> bool:
        return self.hid_idle() < 3.0

    @staticmethod
    def front_bundle() -> str | None:
        asn = run(["/usr/bin/lsappinfo", "front"]).stdout.strip()
        if not asn:
            return None
        out = run(["/usr/bin/lsappinfo", "info", "-only", "bundleid", asn]).stdout
        m = re.search(r'"CFBundleIdentifier"="([^"]+)"', out)
        return m.group(1) if m else None

    @staticmethod
    def bundle_pid(bundle: str) -> int | None:
        m = re.search(r'"pid"=(\d+)', run(["/usr/bin/lsappinfo", "info", "-only", "pid", "-app", bundle]).stdout)
        return int(m.group(1)) if m else None

    @staticmethod
    def open_link(path: str) -> None:
        run(["/usr/bin/open", "-g", "wispr-flow://" + path])

    def prefs(self) -> dict:
        return json.loads((self.support / "config.json").read_text()).get("prefs", {}).get("user", {})

    def mic(self) -> tuple[str | None, str | None]:
        user = self.prefs()
        dev = user.get("overrideAudioDeviceId")
        names = {d.get("deviceId"): d.get("name") for d in user.get("rankedAudioDevices") or []}
        return dev, names.get(dev)

    def ranked_names(self) -> list[str]:
        loop = self.c["loopback_mic"]
        return [d["name"] for d in self.prefs().get("rankedAudioDevices") or []
                if d.get("name") and not d["name"].startswith(loop) and d.get("deviceId") != "default"]

    def switch_mic(self, prefix: str) -> None:
        self.open_link("switch-mic?mic_name=" + quote(prefix))

    def restore_mic(self, prev_dev: str | None, prev_name: str | None) -> None:
        """The previous mic first; if it is gone, the next ranked mic, never the loopback."""
        for name in ([prev_name] if prev_name else []) + [n for n in self.ranked_names() if n != prev_name]:
            self.switch_mic(name)
            for _ in range(10):
                time.sleep(0.2)
                dev, cur = self.mic()
                if dev == prev_dev or cur == name:
                    return
        self.log_event({"event": "wispr_mic_restore_failed"})

    def db(self) -> sqlite3.Connection:
        return sqlite3.connect(f"file:{quote(str(self.support / 'flow.sqlite'))}?mode=ro", uri=True, timeout=5)

    def last_ts(self) -> str:
        with self.db() as c:
            return c.execute("select max(timestamp) from History").fetchone()[0] or ""

    def new_row(self, after: str) -> tuple | None:
        """(status, text, app) of the newest History row since `after`; `app` is where Wispr pasted."""
        with self.db() as c:
            return c.execute(
                "select status, coalesce(nullif(formattedText,''), asrText, ''), coalesce(app,'') from History"
                " where timestamp > ? and status is not null order by timestamp desc limit 1", (after,)).fetchone()

    def loopback_index(self) -> int:
        p = run([which(self.c["ffmpeg"]), "-hide_banner", "-f", "lavfi", "-i", "anullsrc", "-t", "0.01",
                 "-f", "audiotoolbox", "-list_devices", "true", "-"])
        for line in p.stderr.splitlines():
            m = re.search(r"\[(\d+)\]\s+" + re.escape(self.c["loopback_mic"]), line)
            if m:
                return int(m.group(1))
        raise StepError("no loopback device")

    def wait_for_idle(self, status) -> None:
        need, deadline = float(self.c["idle_seconds"]), now() + float(self.c["idle_wait"])
        while True:
            idle = self.hid_idle()
            if idle >= need:
                return
            if now() >= deadline:
                raise UserActive()
            status(f"WAIT {int(need - idle) + 1}")
            time.sleep(min(need - idle, 2.0) + 0.1)

    def transcribe(self, wav: Path, status, rec: dict) -> str:
        self.wait_for_idle(status)
        prev_front = self.front_bundle()
        prev_dev, prev_name = self.mic()
        baseline = self.last_ts()
        device = self.loopback_index()
        stop_flag = self.sink_app.parent / "sink.stop"

        def guard() -> None:
            if self.user_active():
                raise UserActive()

        try:
            stop_flag.unlink(missing_ok=True)
            guard()
            run(["/usr/bin/open", str(self.sink_app)])
            for _ in range(30):
                if self.front_bundle() == self.sink_id:
                    break
                time.sleep(0.1)
            else:
                raise StepError("sink not front")
            guard()
            self.switch_mic(self.c["loopback_mic"])
            time.sleep(0.6)
            self.open_link("start-hands-free")
            time.sleep(0.8)
            guard()
            play = subprocess.Popen(
                [which(self.c["ffmpeg"]), "-hide_banner", "-loglevel", "error", "-re", "-i", str(wav),
                 "-af", "apad=pad_dur=0.6", "-ac", "2", "-ar", "48000", "-f", "audiotoolbox",
                 "-audio_device_index", str(device), "-"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            while play.poll() is None:
                if self.user_active():
                    play.terminate()
                    play.wait(5)
                    self.open_link("stop-hands-free")
                    raise UserActive()
                time.sleep(0.25)
            rec["front_at_stop"] = self.front_bundle()
            self.open_link("stop-hands-free")
            deadline, raw_since = now() + 45, None
            while now() < deadline:
                row = self.new_row(baseline)
                if row:
                    rec["wispr_status"], rec["wispr_app"] = row[0], row[2]
                if row and row[0] in ("empty", "no_audio", "error"):
                    raise StepError(f"wispr {row[0]}")
                if row and row[1].strip():
                    if row[0] == "formatted" or (raw_since and now() - raw_since > 3):
                        return row[1].strip()
                    raw_since = raw_since or now()
                time.sleep(0.2)
            raise StepError("wispr no transcript")
        finally:
            self.restore_mic(prev_dev, prev_name)
            stop_flag.touch()
            for _ in range(10):
                if not self.bundle_pid(self.sink_id):
                    break
                time.sleep(0.2)
            else:
                pid = self.bundle_pid(self.sink_id)
                if pid:
                    os.kill(pid, signal.SIGTERM)
            if prev_front and prev_front != self.sink_id and self.front_bundle() != prev_front:
                run(["/usr/bin/open", "-b", prev_front])
            self.log_event({"event": "wispr_restore", "front_restored": self.front_bundle() == prev_front,
                            "mic_restored": self.mic()[0] == prev_dev})


SINK_JS = r"""
ObjC.import('Cocoa');
var stopPath = $.NSBundle.mainBundle.bundlePath.js.replace(/\/[^\/]+$/, '') + '/sink.stop';
var started = Date.now();
var win, tv;
function run() {
  win = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer($.NSMakeRect(0, 0, 360, 110), 1, $.NSBackingStoreBuffered, false);
  win.title = 'talkstick';
  tv = $.NSTextView.alloc.initWithFrame($.NSMakeRect(0, 0, 360, 110));
  win.contentView = tv;
  win.center;
  win.makeKeyAndOrderFront(null);
  win.makeFirstResponder(tv);
  $.NSApplication.sharedApplication.activateIgnoringOtherApps(true);
}
function idle() {
  if ($.NSFileManager.defaultManager.fileExistsAtPath(stopPath) || Date.now() - started > 120000) {
    $.NSApplication.sharedApplication.terminate(null);
  }
  return 0.3;
}
"""


def build_sink(cfg: dict) -> None:
    w = cfg["engine"]["wispr-macos"]
    app = expand(w["sink_app"])
    app.parent.mkdir(parents=True, exist_ok=True)
    src = app.parent / "TalkstickSink.js"
    src.write_text(SINK_JS)
    steps = [
        ["/usr/bin/osacompile", "-l", "JavaScript", "-s", "-o", str(app), str(src)],
        ["/usr/bin/plutil", "-replace", "CFBundleIdentifier", "-string", w["sink_bundle_id"],
         str(app / "Contents/Info.plist")],
        ["/usr/bin/codesign", "--force", "--sign", "-", str(app)],
    ]
    for cmd in steps:
        p = run(cmd)
        if p.returncode != 0:
            sys.exit(p.stderr)
    with open(app / "Contents/Info.plist", "rb") as f:
        print(f"built {app} ({plistlib.load(f)['CFBundleIdentifier']})")


# Delivery

def deliver_command(ccfg: dict, text: str, rec: dict, dry: bool, on_sent, on_status=lambda kind: None) -> str:
    argv = [os.path.expandvars(os.path.expanduser(a)) for a in ccfg["argv"]]
    if not argv:
        raise StepError("delivery argv empty")
    env = {**os.environ, "TALKSTICK_DEVICE": str(rec.get("device") or ""),
           "TALKSTICK_UTTERANCE_ID": rec.get("utterance_id", ""), "TALKSTICK_DRY": "1" if dry else "0",
           "TALKSTICK_SPOKEN_AT": str(int(rec.get("t_release") or now()))}
    p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, env=env, start_new_session=True)

    def kill() -> None:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass

    timer = threading.Timer(float(ccfg.get("timeout", 660)), kill)
    timer.start()
    handoff, posted, missed = ccfg.get("handoff_timeout"), threading.Event(), threading.Event()

    def give_up() -> None:
        if not posted.is_set():
            missed.set()
            kill()

    handoff_timer = threading.Timer(float(handoff), give_up) if handoff else None
    if handoff_timer:
        handoff_timer.start()
    try:
        p.stdin.write(text)
        p.stdin.close()
        err: list[str] = []
        drain = threading.Thread(target=lambda: err.append(p.stderr.read()), daemon=True)
        drain.start()
        reply, sent = [], False
        for line in p.stdout:
            word = line.strip()
            if word == "@sent" and not reply:
                posted.set()
                on_sent()
                sent = True
            elif word in ("@busy", "@running", "@paused") and sent and not reply:
                on_status(word[1:])
            else:
                reply.append(line)
        rc = p.wait()
        drain.join(5)
    finally:
        timer.cancel()
        if handoff_timer:
            handoff_timer.cancel()
        p.stdout.close()
        p.stderr.close()
    rec["delivery_rc"] = rc
    if missed.is_set():
        raise StepError(f"not posted: the thread did not take it in {float(handoff):g} s")
    if rc == EXIT_OFFLINE:
        raise Offline()
    if rc != 0:
        rec["delivery_stderr"] = "".join(err).strip()[-200:]
        lines = rec["delivery_stderr"].splitlines()
        raise StepError(lines[-1].strip() if lines else f"delivery exit {rc}")
    on_sent()
    return "".join(reply).strip()


def parse_webhook_reply(content_type: str, body: bytes) -> str:
    text = body.decode("utf-8", "replace")
    if "json" in (content_type or ""):
        try:
            data = json.loads(text)
        except ValueError:
            return text.strip()
        if isinstance(data, dict):
            return str(data.get("reply") or "").strip()
    return text.strip()


def deliver_webhook(wcfg: dict, text: str, rec: dict, dry: bool) -> str:
    if not wcfg.get("url"):
        raise StepError("webhook url empty")
    body = json.dumps({"text": text, "device": rec.get("device"), "utterance_id": rec.get("utterance_id"),
                       "dry": dry}).encode()
    req = urllib.request.Request(wcfg["url"], data=body, method="POST",
                                 headers={"Content-Type": "application/json", **wcfg.get("headers", {})})
    try:
        with urllib.request.urlopen(req, timeout=float(wcfg.get("timeout", 660))) as r:
            rec["webhook_status"] = r.status
            return parse_webhook_reply(r.headers.get("Content-Type", ""), r.read())
    except urllib.error.HTTPError as e:
        rec["webhook_status"] = e.code
        if e.code == 503:
            raise Offline()
        raise StepError(f"webhook {e.code}")
    except (urllib.error.URLError, OSError) as e:
        raise StepError(f"webhook {type(e).__name__}")


# Over-the-air updates

def read_ota_key(cfg: dict) -> bytes | None:
    try:
        text = expand(cfg["ota_key_file"]).read_text().strip()
    except OSError:
        return None
    return bytes.fromhex(text) if re.fullmatch(r"[0-9a-fA-F]{64}", text) else None


def ota_mac(key: bytes, sha256_hex: str, version: str) -> str:
    return hmac.new(key, f"talkstick-ota {sha256_hex} {version}".encode(), hashlib.sha256).hexdigest()


def load_manifest(state: Path) -> dict | None:
    try:
        m = json.loads((state / "ota" / "manifest.json").read_text())
    except (OSError, ValueError):
        return None
    keys = ("version", "size", "sha256", "mac", "staged")
    return m if isinstance(m, dict) and all(k in m for k in keys) else None


def stage_ota(cfg: dict, image_path: str, version: str | None = None) -> dict:
    """Copy a checked application image to state_dir/ota and write its manifest; the running daemon offers it
    within a second. Returns the manifest."""
    key_file = expand(cfg["ota_key_file"])
    key = read_ota_key(cfg)
    if key is None:
        raise StepError(f"no OTA key in {key_file}: it must hold 64 hex characters (32 bytes), the same key the "
                        "firmware build embeds. Create one with: openssl rand -hex 32 > " + str(key_file))
    data = Path(image_path).expanduser().read_bytes()
    if not data or data[0] != 0xE9:
        raise StepError(f"{image_path} is not an ESP32 application image (first byte is not 0xE9)")
    if len(data) > OTA_MAX_BYTES:
        raise StepError(f"{image_path} is {len(data)} bytes, more than the app slot's {OTA_MAX_BYTES}")
    if not version:
        m = re.search(OTA_VERSION_RE, data)
        if not m:
            raise StepError("no talkstick-X.Y.Z version string in the image; pass --version")
        version = m.group(0).decode()
    sha = hashlib.sha256(data).hexdigest()
    manifest = {"version": version, "size": len(data), "sha256": sha, "mac": ota_mac(key, sha, version),
                "staged": time.strftime("%Y-%m-%dT%H:%M:%S") + f".{int(now() * 1000) % 1000:03d}"}
    state = expand(cfg["state_dir"])
    write_atomic(state / "ota" / "image.bin", data)
    write_atomic(state / "ota" / "manifest.json", json.dumps(manifest, indent=1).encode())
    return manifest


def ota_cmd(d: Daemon, args: list[str]) -> None:
    """talkstick ota IMAGE [--version V] [--timeout S]: stage, then wait for the stick to say hello with it."""
    opts, rest = {"--version": None, "--timeout": "300"}, []
    it = iter(args)
    for a in it:
        if a in opts:
            opts[a] = next(it, None)
        else:
            rest.append(a)
    if len(rest) != 1 or opts["--timeout"] is None:
        sys.exit(__doc__)
    try:
        start = d.events.stat().st_size
    except OSError:
        start = 0
    try:
        m = stage_ota(d.cfg, rest[0], opts["--version"])
    except (StepError, OSError) as e:
        sys.exit(f"talkstick ota: {e}")
    t0 = now()
    print(f"staged {m['version']} ({m['size']} bytes, sha256 {m['sha256'][:12]}); waiting for the stick", flush=True)
    while now() - t0 < float(opts["--timeout"]):
        try:
            with open(d.events, "rb") as f:
                f.seek(start)
                rows = f.read().decode("utf-8", "replace").splitlines()
        except OSError:
            rows = []
        for row in rows:
            try:
                r = json.loads(row)
            except ValueError:
                continue
            if r.get("event") == "ota_applied" and r.get("version") == m["version"]:
                print(f"applied on {r.get('device')} after {now() - t0:.1f} s")
                return
        time.sleep(0.5)
    sys.exit(f"talkstick ota: no stick said hello with {m['version']} within {opts['--timeout']} s "
             "(the image stays staged)")


# Advertising

def advertise(name: str, stype: str, port: int) -> subprocess.Popen | None:
    if shutil.which("dns-sd"):
        cmd = ["dns-sd", "-R", name, stype, "local", str(port)]
    elif shutil.which("avahi-publish"):
        cmd = ["avahi-publish", "-s", name, stype, str(port)]
    else:
        return None
    return subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kill_stale_advertiser(state_file: Path) -> None:
    try:
        pid = json.loads(state_file.read_text()).get("advertiser_pid")
    except (OSError, ValueError):
        return
    if pid and re.search(r"dns-sd|avahi", run(["ps", "-o", "comm=", "-p", str(pid)]).stdout):
        os.kill(pid, signal.SIGTERM)


# Commands

def bench(d: Daemon, wav_path: str) -> None:
    rec: dict = {"t_release": now(), "wav": wav_path, "bench": True, "device": "bench", "utterance_id": uuid.uuid4().hex}
    t0 = rec["t_release"]
    wav = Path(wav_path).expanduser().resolve()
    out = lambda s: print(f"{now() - t0:6.2f}s  {s}", flush=True)
    d.process(lambda: d.transcribe(wav, out, rec), out, rec, d.turn.take())
    print(json.dumps({k: v for k, v in rec.items() if k.startswith("d_") or k in ("engine", "outcome", "error")}))


def fake_watch(s: socket.socket) -> None:
    """Print every watch line with the wall-clock time and ack each ANSWER, until the daemon closes."""
    s.settimeout(30)
    s.sendall(b"M5R1 fakestick 100 fake-1\nW\x00\x00")
    try:
        for raw in s.makefile("rb"):
            line = raw.decode(errors="replace").rstrip("\n")
            print(f"{time.strftime('%H:%M:%S')}  {line}", flush=True)
            words = line.split()
            if words[:1] == ["ANSWER"] and len(words) > 1:
                s.sendall(b"K" + struct.pack("<H", len(words[1])) + words[1].encode())
    except socket.timeout:
        sys.exit("fake-stick: no line from the daemon for 30 s")
    except KeyboardInterrupt:
        pass


def fake_stick(cfg: dict, mode: str, wav_path: str | None, target: str = "127.0.0.1") -> None:
    """mode: utterance (stream wav_path then E), status (S), ping (P), watch (W). Prints each line with seconds
    since the last frame was sent (watch: the time of day); a ping reads until the daemon closes."""
    host, _, port = target.partition(":")
    if mode == "watch":
        fake_watch(socket.create_connection((host, int(port or cfg["port"])), timeout=5))
        return
    pcm = b""
    if mode == "utterance":
        with wave.open(wav_path, "rb") as w:
            if (w.getnchannels(), w.getsampwidth(), w.getframerate()) != (1, 2, RATE):
                sys.exit("fake-stick needs a 16 kHz mono s16 WAV")
            pcm = w.readframes(w.getnframes())
    s = socket.create_connection((host, int(port or cfg["port"])), timeout=5)
    s.settimeout(660)
    s.sendall(b"M5R1 fakestick 100 fake-1\n")
    for i in range(0, len(pcm), 4096):
        chunk = pcm[i:i + 4096]
        s.sendall(b"A" + struct.pack("<H", len(chunk)) + chunk)
    s.sendall({"utterance": b"E", "status": b"S", "ping": b"P"}[mode] + b"\x00\x00")
    t_end = now()
    for raw in s.makefile("rb"):
        line = raw.decode(errors="replace").strip()
        print(f"{now() - t_end:6.2f}s  {line}", flush=True)
        if mode != "ping" and line.split()[:1] in (["REPLIED"], ["OFFLINE"], ["ERR"]):
            break
    s.close()


def status_cmd(d: Daemon) -> None:
    try:
        st = json.loads((d.state / "state.json").read_text())
    except (OSError, ValueError):
        st = {}
    port = st.get("port", d.cfg["port"])
    up = run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"]).stdout.strip()
    print(f"daemon: {'up' if up else 'down'} port {port} pid {st.get('pid')} engine {st.get('engine')} "
          f"delivery {st.get('delivery')} dry {st.get('dry')}")
    rows = []
    try:
        rows = [r for r in map(json.loads, d.events.read_text().splitlines()) if r.get("event") == "utterance"]
    except (OSError, ValueError):
        pass
    for r in rows[-5:]:
        t = " ".join(f"{k[2:]}={r[k]}" for k in ("d_transcript", "d_sent", "d_reply", "d_done") if k in r)
        print(f"  {r['ts']} {r.get('engine')}/{r.get('delivery')} {r.get('outcome')} audio={r.get('audio_s')}s {t}")
    try:
        queues = json.loads(d.queue_file.read_text()) if up else {}
    except (OSError, ValueError):
        queues = {}
    for device, q in queues.items():
        waiting, busy, ahead, paused = q["queue"]
        print(f"queue {device}: waiting {waiting} busy {busy} ahead {ahead} paused {paused}")
        for i in q["items"]:
            print(f"  {i['id']} {i['state']} {now() - i['since']:.0f}s")
    m = load_manifest(d.state)
    print(f"ota: {m['version']} staged {m['staged']}" if m else "ota: nothing staged")


def main(argv: list[str]) -> None:
    cfg = load_config()
    if "--dry" in argv:
        cfg["dry"] = True
        argv = [a for a in argv if a != "--dry"]
    d = Daemon(cfg)
    cmd = argv[1] if len(argv) > 1 else "serve"
    if cmd == "serve":
        d.serve()
    elif cmd == "bench" and len(argv) == 3:
        bench(d, argv[2])
    elif cmd == "fake-stick" and len(argv) >= 3:
        args = argv[2:]
        flags = {"--status": "status", "--ping": "ping", "--watch": "watch"}
        mode = next((flags[a] for a in args if a in flags), "utterance")
        args = [a for a in args if a not in flags]
        if mode == "utterance" and not 1 <= len(args) <= 2:
            sys.exit(__doc__)
        if mode != "utterance" and len(args) > 1:
            sys.exit(__doc__)
        wav = args.pop(0) if mode == "utterance" else None
        fake_stick(cfg, mode, wav, *args)
    elif cmd == "status":
        status_cmd(d)
    elif cmd == "ota":
        ota_cmd(d, argv[2:])
    elif cmd == "build-sink":
        build_sink(cfg)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
