# talkstick firmware build config. Copy to ~/.config/talkstick/firmware.env (chmod 600) and fill in.
# build.sh reads it at build time and writes a private header outside the repo; nothing here is committed.
TALKSTICK_WIFI_SSID=your-network
TALKSTICK_WIFI_PASS=your-password
# Bonjour service the daemon advertises, without the leading underscore or ._tcp
TALKSTICK_SERVICE=m5remote
TALKSTICK_PORT=47820
# Tried when the service lookup finds nothing, e.g. your-mac.local (empty to skip)
TALKSTICK_HOST_FALLBACK=
